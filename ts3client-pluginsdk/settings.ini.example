[ts]
channel="default" #ts channel to connect

[ucontroller]
# microcontroller settings
ip="127.0.0.1"
at_port=8001 #port where to send commands

[noise]
#settings to handle noise removal (from the ucontroller)
cancelnoise=0
noiseprofilefile="~/.local/share/teamspeak-gsm/noiseprofile.pcm"
noiserecordingfile="~/.local/share/teamspeak-gsm/noise.pcm"
noisesupprlevel=6 #1 is lower noise, but also worse quality

[permissions]
allow_send_sms=1
allow_delete_sms=1
allow_create_contacts=1
allow_delete_contacts=1

[audio]
# audio exchanged with the ucontroller
sample_rate=16000 #Hz, both directions; MUST match AUDIO_SAMPLE_RATE in ttgo/main/SETTINGS.h
bandpass_low_hz=300 #high-pass on the audio from the ucontroller, 0 disables
bandpass_high_hz=3400 #low-pass on the audio from the ucontroller, 0 disables
